# ===== TELEGRAM =====
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
TELEGRAM_PHONE=+your-phone-number

# ===== TEXT LLM (Codex subscription via CLI) =====
# Text roles use the authenticated Codex subscription; no text-LLM API key is needed.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Text LLM profile: luna = authenticated Codex CLI; current = optional HTTP backend.
LLM_PROFILE=luna
CODEX_CLI_PATH=codex
# Use the exact model id available to Codex CLI.
CODEX_LUNA_MODEL=gpt-5.6-luna
CODEX_LUNA_REASONING_EFFORT=xhigh
CODEX_LLM_TIMEOUT_SECONDS=300
CODEX_LLM_MAX_CONCURRENCY=1
CODEX_FALLBACK_TO_API=false
REGENERATE_ON_PROFILE_CHANGE=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ASYNC=1
LLM_DELAY_SECONDS=2.0
RAG_BUILD_DELAY_SECONDS=2.0
QUERY_DELAY_SECONDS=0.0
RAG_INSERT_TIMEOUT_SECONDS=600
RAG_DELETE_TIMEOUT_SECONDS=120
QUERY_TIMEOUT_SECONDS=240
FALLBACK_SYNTH_TIMEOUT_SECONDS=45
RAG_FINALIZE_TIMEOUT_SECONDS=30
QUERY_MAX_TOKENS=1200
FALLBACK_SYNTH_MAX_TOKENS=4096
# Optional for reasoning/thinking models on OpenAI-compatible endpoints.
LLM_REASONING_EFFORT=
HYBRID_QUERY_CARDS_ENABLED=true
HYBRID_SYNTH_ENABLED=true
HYBRID_QUERY_CARDS_TOP_K=3
WIKI_ENABLED=false
HYBRID_QUERY_WIKI_ENABLED=false
HYBRID_QUERY_WIKI_TOP_K=2
AUTO_OPEN_REVIEWER_AFTER_RUN=true

# ===== MINIMAL LATE-FUSION RAG V1 =====
# Keep disabled until the frozen A/B acceptance report is reviewed and approved.
LATE_FUSION_ENABLED=false
LATE_FUSION_FTS_TIMEOUT_SECONDS=120
LATE_FUSION_CARD_TOP_K=30
LATE_FUSION_YOUTUBE_TOP_K=15
# Can be raised independently (for example to 30-40) with the input budget.
LATE_FUSION_MAX_SOURCES=20
LATE_FUSION_MAX_INPUT_TOKENS=120000
LATE_FUSION_RUNTIME_CONTEXT_LIMIT=128000

# Optional role-specific chat models. Empty values fall back to LLM_*.
RAG_BUILD_API_KEY=
RAG_BUILD_BASE_URL=
RAG_BUILD_MODEL=
QUERY_API_KEY=
QUERY_BASE_URL=
QUERY_MODEL=
FALLBACK_SYNTH_API_KEY=
FALLBACK_SYNTH_BASE_URL=
FALLBACK_SYNTH_MODEL=
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://openrouter.ai/api/v1
TRANSCRIPTION_MODEL=google/gemini-2.5-flash-lite
TRANSCRIPTION_STT_MODEL=openai/whisper-large-v3
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_TIMEOUT_SECONDS=120
ENRICHMENT_API_KEY=
ENRICHMENT_BASE_URL=
ENRICHMENT_MODEL=
ENRICHMENT_CONCURRENCY=1
# ===== EMBEDDING =====
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_ATTEMPTS=6
EMBEDDING_CONCURRENCY=1

# ===== VISION API =====
VISION_API_KEY=your-api-key-here
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-2.5-flash-lite

# ===== INSTAGRAM DEEP EXTRACT =====
INSTAGRAM_DEEP_EXTRACT_ENABLED=false
INSTAGRAM_VISION_API_KEY=
INSTAGRAM_VISION_BASE_URL=
INSTAGRAM_VISION_MODEL=
INSTAGRAM_FRAME_INTERVAL_SEC=2.0
INSTAGRAM_FRAME_BATCH_SIZE=5
INSTAGRAM_MAX_VIDEO_DURATION_SEC=180
INSTAGRAM_MAX_VIDEO_SIZE_MB=100

# ===== RERANKER =====
RERANKER_ENABLED=false
RERANKER_PROVIDER=openrouter
RERANKER_MODEL=voyageai/rerank-2.5
RERANKER_API_KEY=
RERANKER_BASE_URL=https://openrouter.ai/api/v1
RERANKER_TOP_N=10
RERANKER_CANDIDATE_POOL=50

# ===== PATHS =====
OUTPUT_DIR=./output
RAG_STORAGE_DIR=./rag_storage
CARD_FTS_DB_PATH=./artifacts/card_fts.sqlite
YOUTUBE_NORMALIZED_DIR=./output/normalized_youtube
YOUTUBE_SEGMENTS_DIR=./output/enriched_segments
SOURCE_REGISTRY_DB_PATH=./artifacts/source_registry.sqlite
WIKI_STATE_DB_PATH=./artifacts/wiki_state.sqlite
WIKI_OUTPUT_DIR=./output/wiki
WIKI_SIDECAR_DIR=./wiki_sidecars
STATE_DIR=./state
MEDIA_CACHE_DIR=./media_cache
LOG_DIR=./logs
MEDIA_CAPTURE_ENABLED=true
# 0 means no size limit. Set a byte limit to skip very large native media downloads.
MEDIA_CAPTURE_MAX_BYTES=0
